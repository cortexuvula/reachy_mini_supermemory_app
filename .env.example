# Required: API key for https://supermemory.ai (Bearer token).
# Can also be set from the headless settings UI at /supermemory/.
SUPERMEMORY_API_KEY=

# Optional: override the supermemory API base URL (e.g. for a proxy).
# SUPERMEMORY_BASE_URL=https://api.supermemory.ai

# CLI-mode settings UI bind. Default 127.0.0.1; set to 0.0.0.0 on the robot
# so a LAN client (e.g. your laptop) can reach /supermemory/ at the robot's IP.
# SUPERMEMORY_SETTINGS_HOST=127.0.0.1
# SUPERMEMORY_SETTINGS_PORT=7861

# Realtime VAD tuning. Defaults raised from OpenAI's stock 0.5/200/300 to
# reduce false interruptions when the robot's own speaker bleeds into its mic.
# Lower threshold = more sensitive; longer silence_ms = waits longer to commit
# a user turn.
# SUPERMEMORY_VAD_THRESHOLD=0.7
# SUPERMEMORY_VAD_SILENCE_MS=700
# SUPERMEMORY_VAD_PREFIX_PADDING_MS=400

# Optional: pin recall to a specific list of containerTags (comma-separated).
# When set, the /supermemory/ tag UI is read-only.
# Saves always go to reachy-mini:<active-profile>; this only affects recall.
# SUPERMEMORY_RECALL_CONTAINER_TAGS=reachy-mini:supermemory,hermes

# Tags to exclude from recall (managed by the /supermemory/ settings UI).
# Ignored when SUPERMEMORY_RECALL_CONTAINER_TAGS is set.
# SUPERMEMORY_RECALL_EXCLUDED_TAGS=sm_project_twitter_bookmarks

# Optional: override the inline-memory file path. Defaults to
# $XDG_DATA_HOME/reachy_mini_supermemory_app/inline-memory.json.
# REACHY_MINI_INLINE_MEMORY_FILE=/path/to/inline-memory.json

# Optional: override the inline-memory character cap. Default 3000.
# REACHY_MINI_INLINE_MEMORY_CHAR_LIMIT=3000

# Backend selection is inherited from reachy_mini_conversation_app.
# See reachy_mini_conversation_app/.env.example for OPENAI_API_KEY, GEMINI_API_KEY,
# HF_REALTIME_CONNECTION_MODE, etc.
